# Copy this file to .env and set real values. Never commit .env.
SECRET_KEY=generate-a-new-50-character-or-longer-random-secret
DEBUG=False
ENVIRONMENT=production
ALLOWED_HOSTS=marketplace.example.com,www.marketplace.example.com
CSRF_TRUSTED_ORIGINS=https://marketplace.example.com,https://www.marketplace.example.com
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=marketplace_production
DATABASE_USER=replace-me
DATABASE_PASSWORD=replace-me
DATABASE_HOST=your-managed-postgres-host
DATABASE_PORT=5432
DATABASE_SSL_REQUIRE=True
DATABASE_CONN_MAX_AGE=60
# Render also supplies an Internal Database URL. Set this instead of the
# individual DATABASE_* values when deploying there.
DATABASE_URL=

# Keep this true only when the main domain and all active subdomains have HTTPS.
SECURE_HSTS_PRELOAD=True

# SMTP email provider (for example, Resend SMTP, Postmark, or SendGrid SMTP)
DEFAULT_FROM_EMAIL=Marketplace <noreply@marketplace.example.com>
SERVER_EMAIL=Marketplace Errors <errors@marketplace.example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10

# Cloudflare R2 or another S3-compatible object storage provider.
USE_OBJECT_STORAGE=True
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_STORAGE_BUCKET_NAME=marketplace-media
AWS_S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=media.marketplace.example.com
AWS_QUERYSTRING_AUTH=False

# Optional social sign-in credentials.  Leave blank to hide that provider.
# Create these in Google Cloud Console / Meta for Developers and set the real values
# only in the local .env file or your hosting platform's secret environment variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
