/* =========================================================
   MARKETPLACE HOME PAGE
   ========================================================= */

.home-page {
    min-height: 100vh;
    background: #f5f7fb;
}


/* =========================================================
   TOP NAVBAR
   ========================================================= */

.home-navbar {
    height: 64px;
    background: #ffffff;
    border-bottom: 1px solid #e5e7eb;
    position: sticky;
    top: 0;
    z-index: 1000;
}

.home-navbar .navbar-brand {
    font-size: 1.5rem;
    font-weight: 800;
    color: #2563eb;
}

.home-navbar .navbar-brand:hover {
    color: #1d4ed8;
}

.home-search {
    max-width: 500px;
    width: 100%;
}

.home-search input {
    height: 42px;
    border: 1px solid #d1d5db;
    border-radius: 10px 0 0 10px;
    box-shadow: none;
}

.home-search input:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.10);
}

.home-search button {
    height: 42px;
    border: none;
    border-radius: 0 10px 10px 0;
    background: #2563eb;
    color: #ffffff;
    padding: 0 20px;
}

.home-search button:hover {
    background: #1d4ed8;
}


/* =========================================================
   MAIN LAYOUT
   ========================================================= */

.home-layout {
    display: flex;
    min-height: calc(100vh - 64px);
}


/* =========================================================
   SIDEBAR
   ========================================================= */

.home-sidebar {
    width: 240px;
    flex-shrink: 0;
    background: #ffffff;
    border-right: 1px solid #e5e7eb;
    padding: 24px 14px;
}

.sidebar-title {
    font-size: 0.75rem;
    font-weight: 700;
    color: #9ca3af;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0 12px;
    margin-bottom: 10px;
}

.sidebar-menu {
    list-style: none;
    padding: 0;
    margin: 0;
}

.sidebar-menu li {
    margin-bottom: 4px;
}

.sidebar-menu a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 12px;
    border-radius: 10px;
    color: #374151;
    text-decoration: none;
    font-weight: 500;
    transition: 0.2s ease;
}

.sidebar-menu a:hover {
    background: #eff6ff;
    color: #2563eb;
}

.sidebar-menu a.active {
    background: #2563eb;
    color: #ffffff;
}

.sidebar-icon {
    width: 22px;
    text-align: center;
    font-size: 1.05rem;
}


/* =========================================================
   MAIN CONTENT
   ========================================================= */

.home-main {
    flex: 1;
    min-width: 0;
    padding: 28px;
}


/* =========================================================
   HERO
   ========================================================= */

.home-hero {
    position: relative;
    min-height: 310px;
    display: flex;
    align-items: center;
    overflow: hidden;
    border-radius: 22px;
    padding: 48px;
    margin-bottom: 28px;
    background:
        linear-gradient(
            110deg,
            #1d4ed8 0%,
            #2563eb 45%,
            #60a5fa 100%
        );
    color: #ffffff;
}

.home-hero::before {
    content: "";
    position: absolute;
    width: 380px;
    height: 380px;
    border-radius: 50%;
    right: -100px;
    top: -150px;
    background: rgba(255, 255, 255, 0.10);
}

.home-hero::after {
    content: "";
    position: absolute;
    width: 250px;
    height: 250px;
    border-radius: 50%;
    right: 120px;
    bottom: -150px;
    background: rgba(255, 255, 255, 0.08);
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 650px;
}

.hero-badge {
    display: inline-block;
    padding: 7px 14px;
    margin-bottom: 15px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    font-size: 0.85rem;
    font-weight: 600;
}

.hero-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1.1;
    font-weight: 800;
    margin-bottom: 16px;
}

.hero-description {
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.88);
    margin-bottom: 24px;
}

.hero-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 22px;
    border-radius: 10px;
    background: #ffffff;
    color: #2563eb;
    font-weight: 700;
    text-decoration: none;
    transition: 0.2s ease;
}

.hero-button:hover {
    transform: translateY(-2px);
    background: #f8fafc;
    color: #1d4ed8;
}


/* =========================================================
   SECTION HEADER
   ========================================================= */

.home-section {
    margin-bottom: 34px;
}

.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 18px;
}

.section-title {
    margin: 0;
    font-size: 1.45rem;
    font-weight: 800;
    color: #111827;
}

.section-link {
    color: #2563eb;
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
}

.section-link:hover {
    color: #1d4ed8;
}


/* =========================================================
   CATEGORIES
   ========================================================= */

.category-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 14px;
}

.category-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 115px;
    padding: 15px 10px;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    color: #374151;
    text-decoration: none;
    transition: 0.2s ease;
}

.category-card:hover {
    transform: translateY(-3px);
    border-color: #bfdbfe;
    box-shadow: 0 8px 22px rgba(15, 23, 42, 0.08);
    color: #2563eb;
}

.category-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
    border-radius: 12px;
    background: #eff6ff;
    color: #2563eb;
    font-size: 1.35rem;
}

.category-name {
    font-size: 0.9rem;
    font-weight: 600;
    text-align: center;
}


/* =========================================================
   PRODUCT GRID
   ========================================================= */

.product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
}

.product-card {
    height: 100%;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    transition: 0.25s ease;
}

.product-card:hover {
    transform: translateY(-5px);
    border-color: #dbeafe;
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.10);
}

.product-image-wrapper {
    position: relative;
    height: 205px;
    overflow: hidden;
    background: #f3f4f6;
}

.product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
}

.product-card:hover .product-image {
    transform: scale(1.04);
}

.product-no-image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #9ca3af;
    font-size: 0.9rem;
}

.product-body {
    padding: 16px;
}

.product-category {
    font-size: 0.75rem;
    font-weight: 600;
    color: #6b7280;
    margin-bottom: 7px;
}

.product-name {
    min-height: 48px;
    margin-bottom: 10px;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.5;
    color: #111827;
}

.product-price {
    margin-bottom: 14px;
    color: #2563eb;
    font-size: 1.15rem;
    font-weight: 800;
}

.product-button {
    display: block;
    width: 100%;
    padding: 9px 14px;
    border-radius: 9px;
    background: #2563eb;
    color: #ffffff;
    text-align: center;
    text-decoration: none;
    font-weight: 600;
    transition: 0.2s ease;
}

.product-button:hover {
    background: #1d4ed8;
    color: #ffffff;
}


/* =========================================================
   EMPTY STATE
   ========================================================= */

.home-empty {
    padding: 50px 20px;
    background: #ffffff;
    border: 1px dashed #d1d5db;
    border-radius: 16px;
    text-align: center;
    color: #6b7280;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1200px) {

    .product-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .category-grid {
        grid-template-columns: repeat(4, 1fr);
    }

}


@media (max-width: 992px) {

    .home-sidebar {
        width: 210px;
    }

    .home-main {
        padding: 22px;
    }

    .home-hero {
        padding: 36px;
    }

    .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

}


@media (max-width: 768px) {

    .home-navbar {
        height: auto;
        padding: 10px 0;
    }

    .home-layout {
        display: block;
    }

    .home-sidebar {
        width: 100%;
        border-right: none;
        border-bottom: 1px solid #e5e7eb;
        padding: 10px 14px;
    }

    .sidebar-title {
        display: none;
    }

    .sidebar-menu {
        display: flex;
        gap: 6px;
        overflow-x: auto;
        padding-bottom: 3px;
    }

    .sidebar-menu li {
        flex-shrink: 0;
        margin-bottom: 0;
    }

    .sidebar-menu a {
        white-space: nowrap;
        padding: 9px 12px;
    }

    .home-main {
        padding: 16px;
    }

    .home-hero {
        min-height: 280px;
        padding: 30px 24px;
        border-radius: 18px;
    }

    .hero-title {
        font-size: 2rem;
    }

    .category-grid {
        grid-template-columns: repeat(3, 1fr);
    }

}


@media (max-width: 576px) {

    .home-search {
        margin-top: 10px;
    }

    .home-hero {
        min-height: 250px;
        padding: 26px 20px;
    }

    .hero-title {
        font-size: 1.8rem;
    }

    .hero-description {
        font-size: 0.95rem;
    }

    .section-title {
        font-size: 1.25rem;
    }

    .category-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .product-grid {
        grid-template-columns: 1fr;
    }

    .product-image-wrapper {
        height: 230px;
    }

}