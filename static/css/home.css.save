.home-page {
    background: #f7f8fa;
    min-height: 100vh;
}

.category-sidebar {
    background: #ffffff;
    border: 1px solid #e8eaed;
    border-radius: 14px;
    padding: 1.25rem;
}

.sidebar-title {
    color: #1f2937;
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 1rem;
}

.category-link {
    align-items: center;
    border-radius: 8px;
    color: #4b5563;
    display: flex;
    font-size: 0.95rem;
    justify-content: space-between;
    margin-bottom: 0.25rem;
    padding: 0.75rem;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
}

.category-link:hover,
.category-link.active {
    background: #eef4ff;
    color: #0d6efd;
}

.hero-section {
    background: linear-gradient(135deg, #0d6efd 0%, #5b32c7 100%);
    border-radius: 18px;
    color: #ffffff;
    margin-bottom: 2.5rem;
    overflow: hidden;
    padding: 3rem;
}

.hero-content {
    max-width: 650px;
}

.hero-eyebrow,
.section-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    margin-bottom: 0.5rem;
}

.hero-eyebrow {
    color: #dbeafe;
}

.hero-section h1 {
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1rem;
}

.hero-text {
    color: #e9efff;
    font-size: 1.05rem;
    margin-bottom: 1.5rem;
}

.hero-search {
    display: flex;
    gap: 0.75rem;
}

.hero-search input {
    border: 0;
    border-radius: 9px;
    flex: 1;
    min-width: 0;
    outline: none;
    padding: 0.85rem 1rem;
}

.hero-search button {
    background: #111827;
    border: 0;
    border-radius: 9px;
    color: #ffffff;
    font-weight: 700;
    padding: 0.85rem 1.25rem;
}

.hero-search button:hover {
    background: #000000;
}

.content-section {
    margin-bottom: 2.75rem;
}

.section-heading {
    align-items: end;
    display: flex;
    justify-content: space-between;
    margin-bottom: 1.1rem;
}

.section-label {
    color: #6b7280;
    margin-bottom: 0.2rem;
}

.section-heading h2 {
    color: #1f2937;
    font-size: 1.45rem;
    font-weight: 800;
    margin: 0;
}

.view-all {
    color: #0d6efd;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
}

.category-card {
    align-items: center;
    background: #ffffff;
    border: 1px solid #e8eaed;
    border-radius: 12px;
    color: #1f2937;
    display: flex;
    flex-direction: column;
    font-weight: 700;
    gap: 0.7rem;
    justify-content: center;
    min-height: 125px;
    padding: 1rem;
    text-align: center;
    text-decoration: none;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
}

.category-card:hover {
    box-shadow: 0 10px 24px rgba(31, 41, 55, 0.1);
    color: #0d6efd;
    transform: translateY(-3px);
}

.category-icon {
    font-size: 1.8rem;
}

.product-card {
    background: #ffffff;
    border: 1px solid #e8eaed;
    border-radius: 12px;
    height: 100%;
    overflow: hidden;
}

.product-image {
    align-items: center;
    background: #eef1f5;
    color: #6b7280;
    display: flex;
    height: 175px;
    justify-content: center;
}

.product-image img {
    height: 100%;
    object-fit: cover;
    width: 100%;
}

.product-details {
    padding: 0.9rem;
}

.product-details h3 {
    color: #1f2937;
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0 0 0.45rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.product-price {
    color: #0d6efd;
    font-size: 1rem;
    font-weight: 800;
    margin: 0;
}

.empty-products {
    background: #ffffff;
    border: 1px dashed #cbd5e1;
    border-radius: 12px;
    color: #6b7280;
    padding: 1.5rem;
    text-align: center;
}

@media (max-width: 991.98px) {
    .category-sidebar {
        display: none;
    }
}

@media (max-width: 575.98px) {
    .hero-section {
        padding: 2rem 1.25rem;
    }

    .hero-search {
        flex-direction: column;
    }

    .hero-search button {
        width: 100%;
    }
}